# Local-only development values. Change the placeholders before sharing or deploying.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Development-only convenience; production defaults to disabled.
OWNER_SELF_REGISTRATION_ENABLED=true

# Host-based backend development connection.
DATABASE_URL=postgresql://milk:milk_dev_only@localhost:5432/milk
DATABASE_SSL=false
DB_POOL_MAX=10

# Docker Compose PostgreSQL and API port settings.
POSTGRES_DB=milk
POSTGRES_USER=milk
POSTGRES_PASSWORD=milk_dev_only
POSTGRES_PORT=5432
API_PORT=3000
