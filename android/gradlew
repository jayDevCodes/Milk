#!/usr/bin/env sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROPERTIES="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

if [ ! -f "$PROPERTIES" ]; then
    echo "Gradle wrapper properties not found: $PROPERTIES" >&2
    exit 1
fi

distribution_url=$(sed -n 's/^distributionUrl=//p' "$PROPERTIES" | sed 's/\\:/:/g')
distribution_sha256=$(sed -n 's/^distributionSha256Sum=//p' "$PROPERTIES")

case "$distribution_url" in
    https://services.gradle.org/distributions/gradle-*-bin.zip) ;;
    *) echo "Refusing an untrusted Gradle distribution URL." >&2; exit 1 ;;
esac

archive_name=${distribution_url##*/}
version=${archive_name#gradle-}
version=${version%-bin.zip}

GRADLE_USER_HOME=${GRADLE_USER_HOME:-"$HOME/.gradle"}
cache_root="$GRADLE_USER_HOME/wrapper/dists/gradle-$version-bin/milk-bootstrap"
gradle_home="$cache_root/gradle-$version"
archive="$cache_root/$archive_name"

if [ ! -x "$gradle_home/bin/gradle" ]; then
    command -v curl >/dev/null 2>&1 || { echo "curl is required." >&2; exit 1; }
    command -v unzip >/dev/null 2>&1 || { echo "unzip is required." >&2; exit 1; }
    mkdir -p "$cache_root"
    echo "Downloading Gradle $version..."
    curl --fail --location --retry 3 --proto '=https' --tlsv1.2 "$distribution_url" --output "$archive.part"
    mv "$archive.part" "$archive"

    if command -v shasum >/dev/null 2>&1; then
        actual_sha256=$(shasum -a 256 "$archive" | awk '{print $1}')
    elif command -v sha256sum >/dev/null 2>&1; then
        actual_sha256=$(sha256sum "$archive" | awk '{print $1}')
    else
        echo "A SHA-256 utility is required." >&2
        rm -f "$archive"
        exit 1
    fi

    if [ "$actual_sha256" != "$distribution_sha256" ]; then
        echo "Gradle checksum mismatch." >&2
        rm -f "$archive"
        exit 1
    fi

    unzip -q "$archive" -d "$cache_root"
    rm -f "$archive"
fi

exec "$gradle_home/bin/gradle" --project-dir "$APP_HOME" "$@"
